# Immutable caching for fingerprinted static assets
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Mutable assets (HTML, JSON search index) must revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/index.json
  Cache-Control: public, max-age=0, must-revalidate
